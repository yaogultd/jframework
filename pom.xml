    <build>
        <finalName>jframework</finalName>
        <resources>
            <resource>
                <directory>${basedir}/src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.properties</include>
                    <include>**/*.so</include>
                    <include>**/*.dll</include>
                    <include>**/*.dat</include>
                    <include>*.xml</include>
                    <include>*.properties</include>
                    <include>*.so</include>
                    <include>*.dll</include>
                    <include>*.dat</include>
                </includes>
            </resource>

            <!--作为依赖库打包时-->
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <includes>
                    <include>**/*.so</include>
                    <include>**/*.dll</include>
                    <include>**/*.dat</include>
                    <include>**/*.xml</include>
                    <include>*.so</include>
                    <include>*.dll</include>
                    <include>*.dat</include>
                    <include>**/*.xml</include>
                </includes>
                <excludes>
                    <exclude>static/</exclude>
                    <exclude>templates/</exclude>
                    <exclude>config/</exclude>
                    <exclude>I18N/</exclude>
                    <exclude>service/</exclude>
                    <exclude>tessdata/</exclude>
                    <exclude>webserver/</exclude>
                    <exclude>logback.xml</exclude>
                    <exclude>env.properties</exclude>
                </excludes>
            </resource>

            <!--作为应用打包时
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <includes>
                    <include>**/*.so</include>
                    <include>**/*.dll</include>
                    <include>**/*.dat</include>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.jks</include>
                    <include>*.so</include>
                    <include>*.dll</include>
                    <include>*.dat</include>
                    <include>*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.jks</include>
                </includes>
                <excludes>
                    <exclude>tessdata/</exclude>
                    <exclude>static/</exclude>
                    <exclude>templates/</exclude>
                </excludes>
            </resource>-->
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- 生成源码 JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 生成 Javadoc JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <quiet>true</quiet>
                    <doclint>none</doclint>  <!-- 避免 Javadoc 检查过严导致失败 -->
                </configuration>
            </plugin>

            <!-- GPG 签名插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>

                <dependencies>
                    <dependency>
                        <groupId>org.bouncycastle</groupId>
                        <artifactId>bcpg-jdk18on</artifactId>
                        <version>1.82</version>
                    </dependency>
                </dependencies>

                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- 可执行 gpg 程序的路径（通常默认即可） -->
                    <executable>D:\Programs\GnuPG\bin\gpg.exe</executable>

                    <!-- 启用 gpg-agent 来处理密码，可以避免弹窗问题 -->
                    <passphraseServerId>gpg.passphrase</passphraseServerId>
                    <useAgent>true</useAgent>
                </configuration>
            </plugin>

            <!-- Sonatype Central Portal 发布插件（核心！） -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.4.0</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- 认证信息在 settings.xml 中以 server 标签配置 -->
                    <!-- Central Portal 的认证 ID 必须与下面 server id 一致 -->
                </configuration>
            </plugin>

