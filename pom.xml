        <connection>scm:git:git://github.com/yaogultd/jframework.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yaogultd/jframework.git</developerConnection>
        <url>https://github.com/yaogultd/jframework.git</url>
        <tag>HEAD</tag>
