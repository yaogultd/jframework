<?xml version="1.0" encoding="UTF-8"?>
<web-app>
	<display-name>JFramework</display-name>
	<description>JFramework</description>

	<filter>
		<filter-name>Onlines</filter-name>
		<filter-class>
			j.core.web.online.Onlines
		</filter-class>
	</filter>

	<filter>
		<filter-name>EncodingFilter</filter-name>
		<filter-class>
            j.core.sys.EncodingFilter
        </filter-class>
	</filter>

	<filter>
		<filter-name>ActionRouter</filter-name>
		<filter-class>
			j.core.web.handler.Router
		</filter-class>
	</filter>

	<filter>
		<filter-name>ServiceRouter</filter-name>
		<filter-class>
			j.core.service.server.Router
		</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.html</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.jhtml</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.handler</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.jsp</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>*.xml</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Onlines</filter-name>
		<url-pattern>/</url-pattern>
	</filter-mapping>


	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.jsp</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.handler</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.service</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.html</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.jhtml</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.css</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.js</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>EncodingFilter</filter-name>
		<url-pattern>*.xml</url-pattern>
	</filter-mapping>

	<filter-mapping>
		<filter-name>ActionRouter</filter-name>
		<url-pattern>*</url-pattern>
	</filter-mapping>

	<filter-mapping>
		<filter-name>ServiceRouter</filter-name>
		<url-pattern>*</url-pattern>
	</filter-mapping>

	<servlet>
		<servlet-name>Initializers</servlet-name>
		<servlet-class>
			j.core.web.handler.Initializers
		</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	

	<session-config>
		<session-timeout>360</session-timeout>
	</session-config>
	
	<welcome-file-list>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.jhtml</welcome-file>
	</welcome-file-list>

	<absolute-ordering />
</web-app>
